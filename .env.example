# Supabase: Connect -> ORMs -> Prisma. URL-encode special chars in the password (@ -> %40).
# Transaction pooler, port 6543 - used by the app at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler, port 5432 - used by prisma migrate only.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v23.0
TIKTOK_ACCESS_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHAPA_SECRET_KEY=
