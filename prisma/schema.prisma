generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Currency {
  ETB
  USD
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum Platform {
  WEBSITE
  TELEGRAM
  INSTAGRAM
  TIKTOK
}

enum PublicationStatus {
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  SCHEDULED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  CHAPA
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id               String     @id @default("default")
  storeName        String     @default("My Store")
  defaultCurrency  Currency   @default(ETB)
  timezone         String     @default("Africa/Addis_Ababa")
  defaultPlatforms Platform[] @default([WEBSITE])
  updatedAt        DateTime   @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String
  shortDescription String?
  sku              String?           @unique
  price            Decimal           @db.Decimal(12, 2)
  currency         Currency          @default(ETB)
  stock            Int               @default(0)
  availability     Availability      @default(IN_STOCK)
  status           ProductStatus     @default(DRAFT)
  scheduledAt      DateTime?
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  media            ProductMedia[]
  publications     Publication[]
  platformContent  PlatformContent[]
  sizes            ProductSize[]
  orderItems       OrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, updatedAt])
  @@index([categoryId])
}

model ProductSize {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  stock      Int         @default(0)
  position   Int         @default(0)
  isActive   Boolean     @default(true)
  orderItems OrderItem[]

  @@unique([productId, label])
  @@index([productId, isActive, position])
}

model Order {
  id                 String         @id @default(cuid())
  requestId          String         @unique @default(uuid())
  orderNumber        String         @unique
  recipientFirstName String
  recipientLastName  String
  recipientPhone     String
  email              String?
  emailVerified      Boolean        @default(false)
  deliveryAddress    String?
  latitude           Float?
  longitude          Float?
  locationAccuracy   Float?
  locationAdjusted   Boolean        @default(false)
  deliveryNotes      String?
  subtotal           Decimal        @db.Decimal(12, 2)
  deliveryFee        Decimal        @default(0) @db.Decimal(12, 2)
  total              Decimal        @db.Decimal(12, 2)
  currency           Currency
  status             OrderStatus    @default(PENDING)
  paymentStatus      PaymentStatus  @default(UNPAID)
  paymentMethod      PaymentMethod?
  items              OrderItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([recipientPhone])
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSizeId String?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  productName   String
  sizeLabel     String?
  sku           String?
  unitPrice     Decimal      @db.Decimal(12, 2)
  quantity      Int
  currency      Currency

  @@index([orderId])
  @@index([productId])
  @@index([productSizeId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  filename  String?
  position  Int       @default(0)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([productId, position])
}

model Publication {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform       Platform
  status         PublicationStatus @default(QUEUED)
  externalPostId String?
  externalUrl    String?
  errorMessage   String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, scheduledAt])
  @@index([productId, platform])
}

model PlatformContent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform  Platform
  caption   String?
  hashtags  String?
  ctaText   String?
  ctaUrl    String?

  @@unique([productId, platform])
}
